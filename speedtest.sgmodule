#!name=节点网速测试
#!desc=测试当前 Surge 节点的延迟与下载速度，Cloudflare 不可用时自动切换 Apple CDN
#!author=yoki
#!category=Network Test

[Panel]
speedtest = script-name=speedtest, title="节点网速测试", content="点击刷新开始测速", update-interval=0

[Script]
speedtest = type=generic, timeout=90, script-path=https://raw.githubusercontent.com/weifanglbj/surge-iptest/main/speedtest-panel.js?v=20261128-2, script-update-interval=86400
