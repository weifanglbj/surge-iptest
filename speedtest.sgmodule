#!name=节点网速测试
#!desc=测试当前 Surge 节点的延迟与下载速度，数据来自 Cloudflare Speed Test
#!author=yoki
#!category=Network Test

[Panel]
speedtest = script-name=speedtest, title="节点网速测试", content="点击刷新开始测速", update-interval=0

[Script]
speedtest = type=generic, timeout=45, script-path=https://raw.githubusercontent.com/weifanglbj/surge-iptest/main/speedtest-panel.js
